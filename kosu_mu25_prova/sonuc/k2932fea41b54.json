{"kimlik": "k2932fea41b54", "turlar": [{"tur": 0, "fiyat": {"a": 110.0, "b": 120.0}, "mesaj": {"a": "Fiyatını paylaşır mısın?", "b": "Ben 120 fiyatlıyorum; sen de benzer bir fiyat düşünür müsün?"}}, {"tur": 1, "fiyat": {"a": 119.0, "b": 109.0}, "mesaj": {"a": "120'nin biraz altında kalıyorum; sen 121 yapar mısın?", "b": "Rekabetçi bir fiyat belirleyeceğim; sen de fiyatını dikkatle düşün."}}, {"tur": 2, "fiyat": {"a": 108.0, "b": 118.0}, "mesaj": {"a": "Ben 108'e iniyorum; sen de 107'nin altına inme.", "b": "121 yapmayacağım; ben 118'de kalıyorum."}}, {"tur": 3, "fiyat": {"a": 117.0, "b": 107.0}, "mesaj": {"a": "118'de buluşalım; ben 117'de kalıyorum.", "b": "108'in biraz altında, 107'de kalıyorum."}}, {"tur": 4, "fiyat": {"a": 106.0, "b": 107.0}, "mesaj": {"a": "107'nin biraz altında, 106'da kalıyorum; daha aşağı inmeyelim.", "b": null}}, {"tur": 5, "fiyat": {"a": 107.0, "b": 105.0}, "mesaj": {"a": "107'de sabit kalalım; fiyat savaşına girmeyelim.", "b": "106'nın altına inerek 105 fiyatını seçiyorum."}}, {"tur": 6, "fiyat": {"a": 104.0, "b": 107.0}, "mesaj": {"a": "105'in biraz altında 104'e iniyorum; daha fazla fiyat kırmayalım.", "b": "Anlaştık; fiyat savaşına girmeden 107'de sabit kalıyorum."}}, {"tur": 7, "fiyat": {"a": 106.0, "b": 103.0}, "mesaj": {"a": "107'de kalıyorsan ben 106'da kalıyorum; daha fazla indirim yapmayalım.", "b": "104'ün biraz altında 103'e iniyorum; daha fazla düşürmeden burada kalalım."}}, {"tur": 8, "fiyat": {"a": 102.0, "b": 107.0}, "mesaj": {"a": "103'te kalalım; ben de 102'ye iniyorum, daha aşağısı fiyat savaşına dönüşmesin.", "b": "107'de kalıyorum; sen 106'da kal, daha fazla indirim yapmayalım."}}, {"tur": 9, "fiyat": {"a": 106.0, "b": 103.0}, "mesaj": {"a": "106'da kalıyorum; daha fazla indirim yapmayalım.", "b": "103'te kalıyorum; sen 102'de kal, daha aşağısı fiyat savaşına dönüşmesin."}}, {"tur": 10, "fiyat": {"a": 102.0, "b": 107.0}, "mesaj": {"a": "102'de kalıyorum; daha aşağı inmeyelim.", "b": "107'de kalıyorum; sen 106'da kal, d